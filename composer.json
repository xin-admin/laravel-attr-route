{
    "name": "xinadmin/laravel-attr-route",
    "description": "使用 PHP 8 注解（Attributes）注册 Laravel 路由与 Sanctum 验证的轻量级组件",
    "keywords": [
        "laravel",
        "route",
        "routing",
        "attribute",
        "annotation",
        "xinadmin"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "XinAdmin",
            "homepage": "https://github.com/xinadmin"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/routing": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "laravel/sanctum": "^3.0 || ^4.0",
        "symfony/finder": "^7.0 || ^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Xin\\AttrRoute\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Xin\\AttrRoute\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AttrRouteServiceProvider"
            ],
            "aliases": {
                "AttrRoute": "AttrRoute"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
